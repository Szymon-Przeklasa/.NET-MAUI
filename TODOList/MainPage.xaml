<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TODOList.MainPage"
             Background="#AEC3B0">
    <ContentPage.Resources>
        <Style x:Key="title" TargetType="Label">
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="HeightRequest" Value="50" />
            <Setter Property="WidthRequest" Value="400" />
            <Setter Property="FontSize" Value="40" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontFamily" Value="Secular One" />
        </Style>
        <Style x:Key="todo_entry" TargetType="Entry">
            <Setter Property="HeightRequest" Value="30"/>
            <Setter Property="WidthRequest" Value="250"/>
            <Setter Property="Background" Value="#598392"/>
        </Style>
        <Style x:Key="add_btn" TargetType="Button">
            <Setter Property="WidthRequest" Value="75"/>
            <Setter Property="Background" Value="#D9D9D9"/>
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="BorderWidth" Value="0.5"/>
            <Setter Property="BorderColor" Value="Black"/>
        </Style>
        <Style x:Key="del_btn" TargetType="Button">
            <Setter Property="WidthRequest" Value="85"/>
            <Setter Property="HeightRequest" Value="60"/>
            <Setter Property="Background" Value="#D9D9D9"/>
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="BorderWidth" Value="0.5"/>
            <Setter Property="BorderColor" Value="Black"/>
        </Style>
        <Style x:Key="colview" TargetType="CollectionView">
            <Setter Property="Background" Value="#FEF7FF"/>
            <Setter Property="WidthRequest" Value="412"/>
            <Setter Property="HeightRequest" Value="500"/>
        </Style>
        <Style x:Key="colview_task" TargetType="Label">
            <Setter Property="VerticalOptions" Value="Center"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="WidthRequest" Value="350"/>
            <Setter Property="Margin" Value="15,0,0,0"/>
        </Style>
        <Style x:Key="colview_task_cb" TargetType="CheckBox">
            <Setter Property="VerticalOptions" Value="Center"/>
            <Setter Property="HorizontalOptions" Value="End"/>
            <Setter Property="Color" Value="#124559"/>
        </Style>
        <Style x:Key="info_border" TargetType="Border">
            <Setter Property="Stroke" Value="#124559"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="StrokeShape" Value="Rectangle 40,40,40,40"/>
            <Setter Property="WidthRequest" Value="200"/>
        </Style>
        <Style x:Key="info" TargetType="Label">
            <Setter Property="Background" Value="#598392"/>
            <Setter Property="WidthRequest" Value="200"/>
            <Setter Property="HeightRequest" Value="105"/>
        </Style>
    </ContentPage.Resources>
    <VerticalStackLayout Spacing="15">
        <Label Text="TODO List" Style="{StaticResource title}"></Label>
        <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
            <Entry Style="{StaticResource todo_entry}"></Entry>
            <Button Clicked="addBtn_Clicked" Text="Add" Style="{StaticResource add_btn}"></Button>

        </HorizontalStackLayout>
        <CollectionView Style="{StaticResource colview}" x:Name="collectionview" ItemsSource="{Binding Tasks}" SelectionMode="Single" SelectionChanged="collectionview_SelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <HorizontalStackLayout>
                        <Grid ColumnDefinitions="*,*">
                            <Label Grid.Column="0" Text="{Binding Name}" Style="{StaticResource colview_task}"/>
                            <CheckBox Grid.Column="1" IsChecked="{Binding Done}" Style="{StaticResource colview_task_cb}" CheckedChanged="CheckBox_CheckedChanged"/>
                        </Grid>
                    </HorizontalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
            <Border Style="{StaticResource info_border}">
                <Label x:Name="info" Style="{StaticResource info}" HorizontalOptions="Start"/>
            </Border>
            <Button Text="Delete" Style="{StaticResource del_btn}" Clicked="delBtn_Clicked" VerticalOptions="End"/>
        </HorizontalStackLayout>
    </VerticalStackLayout>

</ContentPage>
